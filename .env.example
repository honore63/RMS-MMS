# =============================================================================
# RMS-MIS server-side environment variables
# Copy to .env.local (git-ignored) for `vercel dev`, or set each value in
# Vercel > Settings > Environment Variables (Production + Preview).
#
# !! NEVER prefix any of these with NEXT_PUBLIC_ !!
#    NEXT_PUBLIC_* values are inlined into browser JavaScript at build time.
#    The service-role key bypasses RLS and can read/write every table, so it
#    must only ever exist in the Vercel server runtime.
# =============================================================================

# Project URL — Supabase dashboard > Project Settings > API
SUPABASE_URL=https://ztlfidglxfwjpxkqfviy.supabase.co

# Server-side service_role key — Supabase dashboard > Project Settings > API
# Keys > service_role  (click "Reveal"). Used ONLY by api/auth/recover.js to set
# temporary passwords through the Supabase Auth admin API.
SUPABASE_SERVICE_ROLE_KEY=

# Public anon key (safe to expose; it is also in frontend/js/config.js).
# Used by api/auth/recover.js only to validate the signed-in user's own JWT.
SUPABASE_ANON_KEY=
